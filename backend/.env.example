# ──────────────────────────────────────────────────────────────
# 薪火未来 (Xinhuo Future) — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────
APP_NAME=xinhuo-api
APP_VERSION=0.4.0
DEBUG=false
ENVIRONMENT=development
WEB_ORIGIN=http://localhost:3000

# ── Database (MySQL) ─────────────────────────────────────────
# Full DSN (if set, takes priority over individual vars):
# DATABASE_URL=mysql+pymysql://xinhuo:xinhuo-dev-pwd@mysql:3306/xinhuo?charset=utf8mb4
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=xinhuo
MYSQL_USER=xinhuo
MYSQL_PASSWORD=xinhuo-dev-pwd

# ── Session / Security ───────────────────────────────────────
SECRET_KEY=change-me-in-production-use-random-64-chars

# ── Tencent Cloud COS ────────────────────────────────────────
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=xinhuo-files-1234567890
COS_REGION=ap-guangzhou

# ── LLM / AI ─────────────────────────────────────────────────
LLM_API_KEY=
DEEPSEEK_API_KEY=

# ── Tencent Cloud ASR / TTS ──────────────────────────────────
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
