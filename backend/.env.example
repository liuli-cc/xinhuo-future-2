# ──────────────────────────────────────────────────────────────
# 薪火未来 (Xinhuo Future) — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────
APP_NAME=xinhuo-api
APP_VERSION=0.5.0
DEBUG=false
ENVIRONMENT=development
WEB_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HEADERS=false

# ── Database (MySQL) ─────────────────────────────────────────
# Full DSN (if set, takes priority over individual vars):
# DATABASE_URL=mysql+pymysql://xinhuo:xinhuo-dev-pwd@mysql:3306/xinhuo?charset=utf8mb4
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=xinhuo
MYSQL_USER=xinhuo
MYSQL_PASSWORD=xinhuo-dev-pwd

# ── Session / Security ───────────────────────────────────────
SECRET_KEY=change-me-in-production-use-random-64-chars
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800
# 本地前后端分端口时返回 Bearer token；正式同站部署必须设为 false，
# 仅使用 HttpOnly Cookie，避免 JavaScript 读取会话令牌。
RETURN_SESSION_TOKEN=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# ── Tencent Cloud COS ────────────────────────────────────────
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=xinhuo-files-1234567890
COS_REGION=ap-guangzhou
FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=5242880

# ── LLM / AI ─────────────────────────────────────────────────
LLM_API_KEY=
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENCY=4
ALLOW_CLIENT_LLM_KEYS=false

# ── Observability ───────────────────────────────────────────
# 正式环境必填；采集 /metrics 时使用 Authorization: Bearer <token>
METRICS_TOKEN=

# ── Privacy / Retention ─────────────────────────────────────
PRIVACY_VERSION=2026-08-13
TERMS_VERSION=2026-08-13
ACCOUNT_DELETION_GRACE_DAYS=7
AUDIT_RETENTION_DAYS=365

# ── Tencent Cloud ASR / TTS ──────────────────────────────────
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
