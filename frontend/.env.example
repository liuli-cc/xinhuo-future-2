# Public build-time endpoint for the FastAPI service. Do not put database
# credentials, API keys, or any private token in this file.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional open-source Chinese realtime speech services. The browser tries
# SoulX-Duplug, FunASR 2-pass, local sherpa-onnx, then Chrome SpeechRecognition.
# Use wss:// endpoints when the frontend itself is served over HTTPS.
NEXT_PUBLIC_SOULX_DUPLEX_WS_URL=
NEXT_PUBLIC_FUNASR_WS_URL=
NEXT_PUBLIC_SHERPA_ONNX_WS_URL=ws://localhost:6006
